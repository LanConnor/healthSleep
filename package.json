  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-health": "^8.11.13",
    "chart.js": "^4.6.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
