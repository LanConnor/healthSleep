{
  "name": "apple-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "健康数据看板：Vite + TypeScript + Capacitor 脚手架（浏览器用 Mock 数据，真机走 HealthKit）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
